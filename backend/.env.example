# PostgreSQL is the only application database (no SQLite fallback).
DATABASE_URL=postgresql+psycopg://shopsphere:shopsphere@localhost:5432/shopsphere_test

# Generate a long random value for production (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`)
SECRET_KEY=change-me-to-a-long-random-string

ENVIRONMENT=development

# Optional: override origins (comma-separated)
# BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
